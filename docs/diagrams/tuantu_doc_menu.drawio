        <mxCell id="note2" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;size=14;fontSize=10;align=left;" value="Trường hợp lỗi: nếu mất mạng / lỗi API (HTTP 429, 503...) → MenuViewModel yêu cầu TtsManager đọc thông báo lỗi; người dùng vuốt lên để thử lại." vertex="1">
          <mxGeometry height="55" width="620" x="20" y="735" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Hình 5.2. Mô hình triển khai hệ thống trong mạng LAN\n\nskinparam shadowing false\nskinparam linetype ortho\n\nskinparam node {\n    BackgroundColor #F5F5F5\n    BorderColor #555555\n}\n\nskinparam component {\n    BackgroundColor #DAE8FC\n    BorderColor #6C8EBF\n}\n\nskinparam database {\n    BackgroundColor #F8CECC\n    BorderColor #B85450\n}\n\nnode \&quot;Thiết bị Android\\n(Người dùng khiếm thị)\&quot; as Phone {\n\n    component \&quot;Ứng dụng Mắt AI\\n(Compose UI + ViewModel)\&quot; as App\n\n    component \&quot;YOLOv10n - TensorFlow Lite\\n(Nhận diện tiền mặt)\&quot; as Yolo #FFE6CC\n\n    database \&quot;Room Database\\nDataStore\&quot; as DB\n\n    component \&quot;Android Text-to-Speech\\n(Dự phòng khi mất kết nối)\&quot; as ATTS #FFF2CC\n}\n\nnode \&quot;Máy chủ suy luận nội bộ\\n(LAN Server có GPU)\&quot; as Server {\n\n    component \&quot;Mô hình VLM\\n(LLaVA / Llama Vision)\\nPhân tích thực đơn\&quot; as VLM #D5E8D4\n\n    component \&quot;Dịch vụ Text-to-Speech\\nTiếng Việt\&quot; as TTS #FFF2CC\n}\n\nApp ..&gt; Yolo : Nhận diện tiền\nApp ..&gt; DB : Đọc/Ghi dữ liệu\nApp ..&gt; ATTS : Phát âm ngoại tuyến\n\nPhone -[#1F6FBF,bold]-&gt; Server :\nKết nối Wi-Fi/LAN\\n\nGửi ảnh thực đơn\\n\nNhận dữ liệu JSON món ăn và giá\\n\nNhận âm thanh TTS\n\nnote bottom of Phone\nNhận diện tiền được thực hiện hoàn toàn\ntrên thiết bị bằng TensorFlow Lite,\nkhông yêu cầu kết nối mạng.\nend note\n\nnote bottom of Server\nMáy chủ xử lý VLM và TTS trong mạng nội bộ.\nDữ liệu không được gửi tới dịch vụ đám mây,\nđảm bảo quyền riêng tư và giảm độ trễ.\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="5ImdDY7YwNHayUtqrntu-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="540" width="614" x="66" y="780" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n  skinparam shadowing false\n  skinparam linetype ortho\n  skinparam node {\n    BackgroundColor #F5F5F5\n    BorderColor #555555\n  }\n  skinparam component {\n    BackgroundColor #DAE8FC\n    BorderColor #6C8EBF\n  }\n  skinparam database {\n    BackgroundColor #F8CECC\n    BorderColor #B85450\n  }\n\n  node \&quot;Dien thoai Android\\n(nguoi dung khiem thi)\&quot; as Phone {\n    component \&quot;App Mat AI\\n(Compose UI + ViewModel)\&quot; as App\n    component \&quot;YOLOv10n - TFLite\\n(nhan dien tien, on-device)\&quot; as Yolo #FFE6CC\n    database \&quot;Room / DataStore\\n(lich su, cai dat)\&quot; as DB\n    component \&quot;Android TTS\\n(giong du phong)\&quot; as ATTS #FFF2CC\n  }\n\n  node \&quot;May chu suy luan noi bo\\n(LAN server, co GPU)\&quot; as Server {\n    component \&quot;VLM doc menu\\n(LLaVA / Llama Vision)\&quot; as VLM #D5E8D4\n    component \&quot;Dich vu TTS\\ntieng Viet noi bo\&quot; as TTS #FFF2CC\n  }\n\n  App ..&gt; Yolo : goi noi bo\n  App ..&gt; DB : doc / ghi\n  App ..&gt; ATTS : khi server offline\n\n  Phone -[#1F6FBF,bold]-&gt; Server : Wi-Fi / LAN noi bo\\nHTTP: anh menu -&gt; JSON mon+gia\\nvan ban -&gt; am thanh\n\n  note bottom of Phone\n    Nhan dien tien chay hoan toan tren may\n    (khong can mang).\n  end note\n\n  note bottom of Server\n    Khong phu thuoc Internet / dam may ben thu ba.\n    Du lieu menu khong ra khoi to chuc.\n  end note\n  @enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="5ImdDY7YwNHayUtqrntu-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="376" width="1461" x="120" y="1610" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n  skinparam shadowing false\n  skinparam linetype ortho\n  skinparam node {\n    BackgroundColor #F5F5F5\n    BorderColor #555555\n  }\n  skinparam component {\n    BackgroundColor #DAE8FC\n    BorderColor #6C8EBF\n  }\n  skinparam database {\n    BackgroundColor #F8CECC\n    BorderColor #B85450\n  }\n\n  node \&quot;Dien thoai Android\\n(nguoi dung khiem thi)\&quot; as Phone {\n    component \&quot;App Mat AI\\n(Compose UI + ViewModel)\&quot; as App\n    component \&quot;YOLOv10n - TFLite\\n(nhan dien tien, on-device)\&quot; as Yolo #FFE6CC\n    database \&quot;Room / DataStore\\n(lich su, cai dat)\&quot; as DB\n    component \&quot;Android TTS\\n(giong du phong)\&quot; as ATTS #FFF2CC\n  }\n\n  node \&quot;May chu suy luan noi bo\\n(LAN server, co GPU)\&quot; as Server {\n    component \&quot;VLM doc menu\\n(LLaVA / Llama Vision)\&quot; as VLM #D5E8D4\n    component \&quot;Dich vu TTS\\ntieng Viet noi bo\&quot; as TTS #FFF2CC\n  }\n\n  App ..&gt; Yolo : goi noi bo\n  App ..&gt; DB : doc / ghi\n  App ..&gt; ATTS : khi server offline\n\n  Phone -[#1F6FBF,bold]-&gt; Server : Wi-Fi / LAN noi bo\\nHTTP: anh menu -&gt; JSON mon+gia\\nvan ban -&gt; am thanh\n\n  note bottom of Phone\n    Nhan dien tien chay hoan toan tren may\n    (khong can mang).\n  end note\n\n  note bottom of Server\n    Khong phu thuoc Internet / dam may ben thu ba.\n    Du lieu menu khong ra khoi to chuc.\n  end note\n  @enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="5ImdDY7YwNHayUtqrntu-3">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
