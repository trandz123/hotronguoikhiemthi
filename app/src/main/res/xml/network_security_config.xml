<?xml version="1.0" encoding="utf-8"?>
<!--
    Buoc tat ca traffic phai qua HTTPS. Khong cho phep cleartext.
    FPT.AI TTS endpoint: https://api.fpt.ai/hmi/tts/v5
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
